{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@cotree/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@cotree/plugin-sdk/service": ["../../packages/plugin-sdk/src/service.ts"],
      "@cotree/plugin-sdk/ui": ["../../packages/plugin-sdk/src/ui.ts"]
    }
  },
  "include": ["src/**/*.ts", "ui/**/*.ts"]
}
