{
  "name": "@cotree/feishu-dingtalk-plugin",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.mts",
    "verify": "node --import tsx scripts/verify.mts",
    "verify:ui": "node --import tsx scripts/verify-ui.mts",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
