{
  "manifestVersion": 3,
  "id": "cotree.example-plugin",
  "name": "example-plugin",
  "version": "0.2.1",
  "description": "可安装的声明式 Skill 示例，说明与 SDK 0.13.0 / API 1 代码扩展的边界。",
  "presentation": {
    "readme": "README.md"
  },
  "minKernelVersion": "0.1.0",
  "entry": "README.md",
  "capabilities": {
    "skills": true
  },
  "permissions": {
    "shell": "none",
    "browser": "none"
  },
  "skills": [
    {
      "name": "cotree.example-plugin.tour",
      "description": "演示 CoTree 插件的原生 Skill 与显式入口格式。",
      "path": "skills/tour/SKILL.md",
      "disableModelInvocation": false
    },
    {
      "name": "cotree.example-plugin.echo",
      "description": "显式运行一个无外部副作用的参数回显示例。",
      "path": "skills/echo/SKILL.md",
      "disableModelInvocation": true
    }
  ],
  "integrity": {
    "algorithm": "sha256",
    "digest": "167c718baee00462ab3fd3891c476c77ce94aeec5c869b099b7fbd185c3f3c8f"
  }
}
